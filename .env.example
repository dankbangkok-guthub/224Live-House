DATABASE_URL=postgres://postgres:postgres@localhost:5432/venue224
APP_ORIGIN=http://localhost:5173
# Only development/test may use the sandbox. No live adapter is enabled.
PAYMENT_MODE=sandbox
ADMIN_API_TOKEN=
SANDBOX_WEBHOOK_SECRET=
# Production admin only: keep customer sandbox/payment routes disabled.
ADMIN_ENABLED=false
CF_ACCESS_ISSUER=
CF_ACCESS_AUD=
# Set true only AFTER the Access app and every Allow policy require MFA.
CF_ACCESS_MFA_REQUIRED=false
# Used only by npm run db:owner, not a runtime auto-provisioning rule.
OWNER_EMAIL=

# Cloudflare direct Neon integration uses request-scoped WebSocket transactions.
# Keep pg for local PostgreSQL, migrations and future Hyperdrive integration.
DATABASE_DRIVER=pg
QUOTE_SIGNING_SECRET=
# Technical quote validity; whole minutes from 1 to 30. Does not reserve capacity.
QUOTE_TTL_MINUTES=15
