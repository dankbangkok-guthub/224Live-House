{
  "name": "224-live-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:demo": "node --import tsx scripts/demo.ts",
    "db:expire": "node --import tsx scripts/expire.ts",
    "dev:vinext": "CLOUDFLARE_BUILD=1 vite dev --port 3001",
    "build:vinext": "CLOUDFLARE_BUILD=1 vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "npm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "build:cloudflare": "CLOUDFLARE_BUILD=1 vite build",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "db:owner": "node --import tsx scripts/owner.ts"
  },
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "pg": "8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "wrangler": "latest"
  }
}
